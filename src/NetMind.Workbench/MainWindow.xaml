                                        </ComboBox>
                                        <Button Content="保存策略" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0" Click="保存数据策略_Click" />
                                        <Button Content="立即整理" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0" Click="立即整理工作区_Click" ToolTip="应用保留/容量策略，清理孤儿正文并压缩 SQLite；不会删除 AI 会话或记录组定义" />
                                        <Button Content="备份工作区" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0" Click="备份工作区_Click" ToolTip="导出包含原始流量、Blob、AI 会话、记录组和配置的完整 ZIP，可能含敏感数据" />
                                        <Button Content="导入备份" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="导入工作区备份_Click" ToolTip="校验备份后创建新的独立工作区，不覆盖现有项目" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.78*" /><ColumnDefinition Width="1.72*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="2,0,2,12"><TextBlock Text="记录组列表" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="TrafficGroupCountText" Text="0 个" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></Grid>
                                    <ListBox x:Name="TrafficGroupList" Grid.Row="1" ItemsSource="{Binding TrafficGroups}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" HorizontalContentAlignment="Stretch" SelectionChanged="记录组选择_Changed" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="13" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding NumberedName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Row="1" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,6,0,0" /></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0"><TextBlock Text="记录组名称" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><TextBox x:Name="TrafficGroupNameBox" MaxLength="80" IsEnabled="False" /></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="说明" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><TextBox x:Name="TrafficGroupDescriptionBox" MaxLength="500" IsEnabled="False" /></StackPanel>
                                    </Grid>
                                    <WrapPanel Grid.Row="1" Margin="0,13,0,0">
                                        <Button x:Name="SaveTrafficGroupButton" Content="保存信息" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,8" Click="保存记录组_Click" />
                                        <Button x:Name="AppendTrafficGroupButton" Content="追加当前选择" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,8" Click="追加记录到组_Click" />
                                        <Button x:Name="RemoveTrafficGroupItemsButton" Content="移除表中选中项" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,8" Click="移除组内记录_Click" />
                                        <Button x:Name="AnalyzeTrafficGroupButton" Content="分析整个记录组" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,8" Click="分析记录组_Click" />
                                        <Button x:Name="ExportTrafficGroupButton" Content="导出记录组" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,8" Click="导出记录组_Click" ToolTip="导出完整 ZIP 归档（含原始正文和 HAR）或标准 HAR 1.2；导出文件可能包含敏感数据" />
                                        <Button x:Name="DeleteTrafficGroupButton" Content="删除记录组" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource RedBrush}" IsEnabled="False" Margin="0,0,0,8" Click="删除记录组_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TrafficGroupStatusText" Grid.Row="2" Text="请选择或新建一个记录组" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10" />
                                    <DataGrid x:Name="TrafficGroupGrid" Grid.Row="3" ItemsSource="{Binding GroupTrafficRows}" PreviewMouseLeftButtonDown="流量列表_左键按下" PreviewMouseRightButtonDown="流量列表_右键按下" ContextMenu="{StaticResource TrafficListContextMenu}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" FontSize="11.5" GridLinesVisibility="All" HorizontalGridLinesBrush="#26FFFFFF" VerticalGridLinesBrush="#26FFFFFF" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="Auto" CanUserSort="False" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding Endpoint}" Width="*" MinWidth="260" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="进程" Binding="{Binding Process}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="AI 分析">
                    <Grid Margin="26,20,26,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <StackPanel><TextBlock Text="AI 对话式分析" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="摘要先行，模型按需用工具取完整数据；多轮追问保留上下文，每一轮都可查看。默认不自动联网。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox x:Name="AiTemplateCombo" Width="186" Margin="0,0,8,0" AutomationProperties.Name="分析模板" ToolTip="新建会话时固定模板，决定系统提示与分析要求" />
                                <Button Content="管理" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="管理提示词_Click" ToolTip="查看与编辑分析模板、新增自定义模板，维护快捷追问列表" />
                                <Button x:Name="CancelAiButton" Content="取消" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0" Click="取消AI分析_Click" />
                                <Button x:Name="RunAiButton" Content="开始新会话" Style="{StaticResource PrimaryButton}" Click="开始新会话_Click" ToolTip="以当前证据池创建新会话并发送首轮分析" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15" Margin="0,0,0,14" MaxWidth="1160" HorizontalAlignment="Left">
                            <Grid MaxWidth="1100">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid HorizontalAlignment="Left" MaxWidth="890">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="420" MaxWidth="560" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="模型网关地址" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><TextBox x:Name="AiEndpointBox" AutomationProperties.Name="模型网关地址" Text="https://api.deepseek.com" TextChanged="AI配置输入_Changed" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="模型" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><TextBox x:Name="AiModelBox" AutomationProperties.Name="模型名称" Text="deepseek-v4-flash" TextChanged="AI配置输入_Changed" /></StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Left" MaxWidth="890">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="420" MaxWidth="560" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid>
                                        <!-- PasswordBox 无占位符能力：已保存密钥且未输入新值时叠加灰色提示，不拦截点击 -->
                                        <PasswordBox x:Name="AiApiKeyBox" AutomationProperties.Name="模型 API 密钥" ToolTip="留空表示保留 Windows 凭据管理器中已保存的密钥" PasswordChanged="AI密钥输入_Changed" />
                                        <TextBlock x:Name="AiApiKeyPlaceholder" Text="已设置密钥 · 留空即沿用已保存密钥" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
                                    </Grid>
                                    <Button Grid.Column="1" Content="保存配置" Style="{StaticResource SecondaryButton}" Padding="13,8" Margin="8,0,0,0" Click="保存AI配置_Click" />
                                    <Button Grid.Column="2" Content="清除密钥" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource RedBrush}" Padding="13,8" Margin="8,0,0,0" Click="清除AI密钥_Click" />
                                    <TextBlock x:Name="AiCredentialStatus" Grid.Row="1" Grid.ColumnSpan="3" Text="正在读取安全配置…" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                </Grid>
                                <Expander Grid.Row="2" Style="{StaticResource EvidenceSectionExpander}" Margin="0,12,0,0" IsExpanded="False">
                                    <Expander.Header><TextBlock Text="高级模型参数（通常保持默认）" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0"><TextBlock Text="接口类型" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><ComboBox x:Name="AiApiStyleCombo" SelectedIndex="0" SelectionChanged="AI配置输入_Changed"><ComboBoxItem Content="Chat Completions" Tag="chat_completions" /><ComboBoxItem Content="Responses" Tag="responses" /></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="推理强度" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><ComboBox x:Name="AiEffortCombo" SelectedIndex="2" SelectionChanged="AI配置输入_Changed"><ComboBoxItem Content="低" Tag="low" /><ComboBoxItem Content="中" Tag="medium" /><ComboBoxItem Content="高" Tag="high" /><ComboBoxItem Content="极高" Tag="xhigh" /><ComboBoxItem Content="最大" Tag="max" /></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="输出上限" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><ComboBox x:Name="AiMaxTokensBox" SelectedIndex="4" SelectionChanged="AI配置输入_Changed" AutomationProperties.Name="AI 输出令牌上限" ToolTip="从预设值中选择输出令牌上限"><ComboBoxItem Content="4096" /><ComboBoxItem Content="8192" /><ComboBoxItem Content="16384" /><ComboBoxItem Content="32768" /><ComboBoxItem Content="65536" /></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="响应上限" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><ComboBox x:Name="AiResponseLimitBox" SelectedIndex="2" SelectionChanged="AI配置输入_Changed" AutomationProperties.Name="AI 响应字节上限" ToolTip="模型网关单次响应字节上限；深度分析输出较大时可适当调大"><ComboBoxItem Content="8 MB" /><ComboBoxItem Content="16 MB" /><ComboBoxItem Content="32 MB" /><ComboBoxItem Content="64 MB" /><ComboBoxItem Content="128 MB" /></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="请求超时（秒）" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><TextBox x:Name="AiTimeoutBox" AutomationProperties.Name="AI 请求超时秒数" ToolTip="模型网关请求超时；范围 10–600 秒" TextChanged="AI配置输入_Changed" /></StackPanel>
                                    </Grid>
                                </Expander>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.92*" /><ColumnDefinition Width="1.75*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock x:Name="FindingTitle" Text="等待流量数据" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><TextBlock x:Name="FindingSummary" Foreground="{StaticResource TextBrush}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock x:Name="FindingConfidence" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" /><TextBlock x:Name="AiEvidenceScopeText" Text="未勾选记录时，只分析当前高亮事务" Foreground="{StaticResource AmberBrush}" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="AI 会话" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="ExportAiConversationButton" Content="导出完整对话" Style="{StaticResource SecondaryButton}" Padding="11,4" IsEnabled="False" Click="导出AI完整会话_Click" ToolTip="导出系统提示、全部提问与回复、工具调用和每轮统计；敏感字段自动脱敏" />
                                                <Button x:Name="DeleteAiConversationButton" Content="删除会话" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource RedBrush}" Padding="11,4" Margin="8,0,0,0" HorizontalAlignment="Right" IsEnabled="False" Click="删除AI会话_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <ListBox x:Name="AiConversationList" Grid.Row="1" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListItem}" ItemsSource="{Binding AiConversationRows}" SelectionMode="Extended" SelectionChanged="AI会话选择_Changed" MouseLeftButtonUp="AI会话列表_点击" Margin="0,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="点击会话恢复全部轮次，可继续追问；Ctrl/Shift 多选后可批量删除">
                                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    <Expander Grid.Row="2" Style="{StaticResource EvidenceSectionExpander}" IsExpanded="False" Margin="0,12,0,0">
                                        <Expander.Header><TextBlock Text="迁移前的旧版分析历史（仅查看）" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" /></Expander.Header>
                                        <Grid Margin="0,8,0,0" MaxHeight="210">
                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <ListBox x:Name="AiLegacyHistoryList" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListItem}" ItemsSource="{Binding AiHistoryRows}" DisplayMemberPath="DisplayName" SelectionChanged="AI历史选择_Changed" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="旧版一次性分析模式的历史记录；新会话不再写入此列表" />
                                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                <Button x:Name="CopyAiResultButton" Content="复制结果" Style="{StaticResource SecondaryButton}" Padding="11,4" IsEnabled="False" Click="复制AI结果_Click" />
                                                <Button x:Name="ExportAiResultButton" Content="导出 MD" Style="{StaticResource SecondaryButton}" Padding="11,4" Margin="8,0,0,0" IsEnabled="False" Click="导出AI结果_Click" />
                                                <Button x:Name="DeleteAiHistoryButton" Content="删除历史" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource RedBrush}" Padding="11,4" Margin="8,0,0,0" IsEnabled="False" Click="删除AI历史_Click" />
                                            </WrapPanel>
                                        </Grid>
                                    </Expander>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="15" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="AiConversationTitle" Text="会话区" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="AiRunStatus" Grid.Column="1" Text="尚未运行对话式分析" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480" /></Grid>
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <ScrollViewer x:Name="AiTurnsScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AiTurnsPanel" /></ScrollViewer>
                                        <FlowDocumentScrollViewer x:Name="AiLegacyViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" IsSelectionEnabled="True" Background="Transparent" Foreground="{StaticResource TextBrush}" ContextMenuOpening="Ai结果_菜单打开" Visibility="Collapsed" />
                                    </Grid>
                                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                        <WrapPanel x:Name="AiQuickFollowUpPanel" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="AiPromptBox" MinHeight="58" MaxHeight="128" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="AI 提问与追问" ToolTip="可输入多行要求；Ctrl+Enter 发送，Enter 换行。" KeyDown="AI追问_回车" />
                                            <Button x:Name="SendAiFollowUpButton" Grid.Column="1" Content="发送&#x0a;Ctrl+Enter" Style="{StaticResource PrimaryButton}" MinWidth="98" Margin="8,0,0,0" Click="发送AI追问_Click" />
