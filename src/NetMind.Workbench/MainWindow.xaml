<Window x:Class="NetMind.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetMind AI · 智能流量分析工作台"
        Icon="Assets/app.ico"
        Width="1460" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BackgroundBrush}"
        PreviewMouseWheel="窗口_滚轮转发">
    <Window.Resources>
        <Style x:Key="TrafficContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrafficMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="菜单背景" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" MinWidth="150">
                                <Grid>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,20,0" />
                                    <TextBlock x:Name="子菜单箭头" Text="›" Foreground="{TemplateBinding Foreground}" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="3,-4,0,0">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True"><Setter TargetName="子菜单箭头" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="菜单背景" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="菜单背景" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter TargetName="菜单背景" Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrafficMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,4" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- 会话筛选徽章内的“清除”小按钮：自绘模板接管 hover，避免系统默认浅蓝高亮在深色底上风格割裂 -->
        <Style x:Key="BadgeClearButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="frame" Background="Transparent" CornerRadius="4" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="#33FFFFFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Background" Value="#4DFFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="TrafficListContextMenu" x:Shared="False" Style="{StaticResource TrafficContextMenuStyle}" Opened="流量菜单_Opened">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource TrafficMenuItemStyle}" />
                <Style TargetType="Separator" BasedOn="{StaticResource TrafficMenuSeparatorStyle}" />
            </ContextMenu.Resources>
            <MenuItem Header="复制" Tag="复制菜单">
                <MenuItem Header="完整 URL" Tag="复制URL" Click="复制事务URL_Click" />
                <MenuItem Header="PowerShell cURL" Tag="复制Curl" Click="右键复制Curl_Click" />
                <Separator />
                <MenuItem Header="完整原始证据" Tag="复制原始证据" Click="右键复制完整证据_Click" />
                <MenuItem Header="脱敏 JSON 副本" Tag="复制脱敏证据" Click="右键复制脱敏副本_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Header="将所选事务加入 AI 证据" Tag="切换AI证据" Click="切换右键AI证据_Click" />
            <MenuItem Header="使用所选事务打开 AI 分析" Tag="打开AI分析" Click="右键打开AI分析_Click" />
            <MenuItem Header="保存勾选到记录组" Tag="保存勾选到记录组" Click="保存勾选到记录组_Click" />
            <MenuItem Header="记录组" Tag="记录组菜单">
                <MenuItem Header="以此事务新建记录组" Tag="新建记录组" Click="右键新建记录组_Click" />
                <MenuItem Header="加入当前记录组" Tag="加入当前记录组" Click="右键加入当前记录组_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Header="快速筛选" Tag="选择过滤">
                <MenuItem Header="主机" Tag="主机" Click="按记录过滤_Click" />
                <MenuItem Header="类型" Tag="类型" Click="按记录过滤_Click" />
                <MenuItem Header="协议" Tag="协议" Click="按记录过滤_Click" />
                <MenuItem Header="方法" Tag="方法" Click="按记录过滤_Click" />
            </MenuItem>
            <MenuItem Header="排除本记录域名" Tag="排除域名" Click="排除域名_Click" />
            <MenuItem Header="清除所有过滤" Tag="清除过滤" Click="清除右键过滤_Click" />
            <Separator />
            <MenuItem Header="删除所选事务…" Tag="删除选择" Foreground="{StaticResource RedBrush}" Click="右键删除选择_Click" />
            <MenuItem Header="删除全部…" Tag="删除全部" Foreground="{StaticResource RedBrush}" Click="右键删除全部_Click" ToolTip="删除当前列表中的所有事务；有过滤条件时只删除过滤后可见的记录" />
        </ContextMenu>
        <!-- JSON 树右键：展开全部 / 折叠全部，处理函数在本窗口代码后台；x:shared=False 保证每棵树持有独立实例，PlacementTarget 才能正确指向被右键的 TreeView -->
        <ContextMenu x:Key="JsonTreeContextMenu" x:Shared="False" Style="{StaticResource TrafficContextMenuStyle}">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource TrafficMenuItemStyle}" />
            </ContextMenu.Resources>
            <MenuItem Header="展开全部" Click="JSON树展开全部_Click" />
            <MenuItem Header="折叠全部" Click="JSON树折叠全部_Click" />
        </ContextMenu>
        <ContextMenu x:Key="AiResultContextMenu" x:Shared="False" Style="{StaticResource TrafficContextMenuStyle}">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource TrafficMenuItemStyle}" />
            </ContextMenu.Resources>
            <MenuItem Header="复制所选内容" Click="复制结果选择_Click" />
            <MenuItem Header="全选结果" Click="全选结果_Click" />
            <MenuItem Header="复制全部结果" Click="复制全部结果_Click" />
        </ContextMenu>
        <!-- 深色列表样式 DarkListItem / DarkListBox 已迁移至 App.xaml 全局资源，供主窗口与缓存选取窗口共用 -->
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="74" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="112" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="6" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                        <TextBlock Text="N" Foreground="#061719" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="NetMind AI" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="智能流量实验室" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="当前工作区" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBlock x:Name="SidebarWorkspaceNameText" Text="正在加载…" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="工作台" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" />
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <Button x:Name="OverviewNav" Content="实时概览" Tag="选中" Style="{StaticResource NavButton}" Click="导航_Click" />
                    <Button x:Name="TrafficNav" Content="流量探索" Style="{StaticResource NavButton}" Click="导航_Click" />
                    <Button x:Name="GroupNav" Content="项目与数据" Style="{StaticResource NavButton}" Click="导航_Click" />
                    <Button x:Name="AiNav" Content="AI 分析" Style="{StaticResource NavButton}" Click="导航_Click" />
                    <Button x:Name="SandboxNav" Content="脚本" Style="{StaticResource NavButton}" Click="导航_Click" />
                    <Button x:Name="WorkspaceNav" Content="安全与会话" Style="{StaticResource NavButton}" Click="导航_Click" />
                    <Button x:Name="SettingsNav" Content="设置" Style="{StaticResource NavButton}" Click="导航_Click" />
                </StackPanel>
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="13">
                    <StackPanel>
                        <TextBlock Text="本地安全模式" Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="AI 接收完整原始证据&#x0a;分析数据保留在本机" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0,24,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="实时概览" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Text="查看真实代理状态与最近流量证据" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="采集方式" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox x:Name="TopCaptureModeCombo" Width="142" SelectedIndex="0" SelectionChanged="采集模式_Changed" Margin="0,0,10,0" AutomationProperties.Name="顶部采集方式">
                            <ComboBoxItem Content="手动代理" Tag="manual_proxy" /><ComboBoxItem Content="自动系统代理" Tag="auto_proxy" /><ComboBoxItem Content="WinDivert 静默" Tag="windivert" />
                        </ComboBox>
                        <CheckBox x:Name="TopSilentBox" Visibility="Collapsed" />
                        <CheckBox x:Name="TopSystemProxyBox" Visibility="Collapsed" />
                        <TextBlock x:Name="ModeSwitchStatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CaptureState" Text="采集器就绪" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button x:Name="BrowserButton" Content="打开采集浏览器" Style="{StaticResource SecondaryButton}" Click="打开浏览器_Click" Margin="0,0,10,0" />
                        <Button x:Name="CloseBrowserButton" Content="关闭采集浏览器" Style="{StaticResource SecondaryButton}" Click="关闭浏览器_Click" Margin="0,0,10,0" AutomationProperties.Name="关闭采集浏览器" />
                        <Button x:Name="CaptureButton" Content="开始采集" Style="{StaticResource PrimaryButton}" Click="切换采集_Click" />
                        <Button x:Name="ProcessCaptureButton" Content="按进程采集" Style="{StaticResource SecondaryButton}" Click="按进程采集_Click" Margin="8,0,0,0" ToolTip="选择进程后仅抓取该进程的流量（需静默抓包模式）：双击进程行即开始" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="0" SelectionChanged="主页面_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabPanel"><Setter Property="Visibility" Value="Collapsed" /></Style>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    </Style>
                </TabControl.Resources>

                <TabItem Header="实时概览">
                    <Grid Margin="26,22,26,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="116" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="网络活动一目了然" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="OverviewMode" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="捕获请求" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="RequestMetric" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="本地持久化记录" Foreground="{StaticResource AccentBrush}" FontSize="11" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="失败率" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ErrorMetric" Text="0%" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="状态码大于等于 400" Foreground="{StaticResource GreenBrush}" FontSize="11" /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="P95 延迟" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="LatencyMetric" Text="0 毫秒" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="最近 200 条请求" Foreground="{StaticResource AmberBrush}" FontSize="11" /></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="端点聚类" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ClusterMetric" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="确定性分析结果" Foreground="{StaticResource BlueBrush}" FontSize="11" /></StackPanel></Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="最近流量" FontSize="15" FontWeight="SemiBold" Margin="18,0" VerticalAlignment="Center" />
                                    <DataGrid x:Name="OverviewGrid" Grid.Row="1" ItemsSource="{Binding TrafficRows}" SelectionChanged="流量选择_Changed" PreviewMouseLeftButtonDown="流量列表_左键按下" PreviewMouseRightButtonDown="流量列表_右键按下" ContextMenu="{StaticResource TrafficListContextMenu}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" FontSize="11.5" CanUserReorderColumns="False" RowStyle="{StaticResource TrafficResourceRow}" GridLinesVisibility="All" HorizontalGridLinesBrush="#26FFFFFF" VerticalGridLinesBrush="#26FFFFFF" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="Auto" CanUserSort="False" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTemplateColumn Header="" Width="46" CanUserResize="False" CanUserSort="False" CellTemplate="{StaticResource TrafficResourceIconTemplate}" />
                                            <DataGridTemplateColumn Width="Auto">
                                                <DataGridTemplateColumn.Header><CheckBox x:Name="OverviewAiSelectAll" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="AI全选_Changed" Unchecked="AI全选_Changed" Indeterminate="AI全选_Changed" ToolTip="全选/清空当前列表的 AI 勾选" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsAiSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="AI记录选择_Changed" Unchecked="AI记录选择_Changed" PreviewMouseDown="AI勾选_按下" ToolTip="Shift+点击：从上次勾选位置到本行范围勾选" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="主机/域名" Binding="{Binding Host}" Width="Auto">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SingleLineCellText}"><Setter Property="ToolTip" Value="{Binding Host}" /></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Path" Binding="{Binding Endpoint}" Width="500">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SingleLineCellText}"><Setter Property="ToolTip" Value="{Binding Endpoint}" /></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="进程" Binding="{Binding Process}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="来源" Binding="{Binding DataSource}" Width="Auto" ElementStyle="{StaticResource SingleLineCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel Margin="18,0" VerticalAlignment="Center">
                                        <TextBlock Text="端点聚类健康度" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="确定性分析 · 点击一行到流量探索筛选该端点" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DataGrid x:Name="OverviewClusterGrid" Grid.Row="1" ItemsSource="{Binding OverviewClusterRows}" SelectionChanged="端点聚类选择_Changed" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="Cell" FontSize="11.5" CanUserReorderColumns="False" GridLinesVisibility="All" HorizontalGridLinesBrush="#26FFFFFF" VerticalGridLinesBrush="#26FFFFFF" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="42" CanUserSort="False" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="52" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="端点" Binding="{Binding Endpoint}" Width="*">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SingleLineCellText}"><Setter Property="ToolTip" Value="{Binding Endpoint}" /></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="请求" Binding="{Binding Requests}" Width="46" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="错误率" Binding="{Binding ErrorRate}" Width="54" ElementStyle="{StaticResource SingleLineCellText}" />
                                            <DataGridTextColumn Header="P95" Binding="{Binding P95}" Width="64" ElementStyle="{StaticResource SingleLineCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="流量探索">
                    <Grid Margin="26,22,26,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TrafficSearch" Width="280" TextChanged="搜索_TextChanged" ToolTip="搜索端点、进程、协议或方法；支持 &amp;&amp;（且）、||（或）、!（非）与 () 分组，例如 api &amp;&amp; (login || token)" AutomationProperties.Name="搜索流量" />
                                    <ComboBox x:Name="StatusFilter" Width="104" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="筛选_Changed">
                                        <ComboBoxItem Content="全部状态" /><ComboBoxItem Content="成功" /><ComboBoxItem Content="异常" />
                                    </ComboBox>
                                    <ComboBox x:Name="SourceFilter" Width="110" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="筛选_Changed">
                                        <ComboBoxItem Content="全部来源" /><ComboBoxItem Content="真实代理" /><ComboBoxItem Content="模拟" /><ComboBoxItem Content="演示" />
                                    </ComboBox>
                                    <Border x:Name="SessionFilterBadge" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Margin="10,0,0,0" Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SessionFilterText" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <Button Content="清除" Style="{StaticResource BadgeClearButton}" Margin="6,0,0,0" Click="清除会话筛选_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
