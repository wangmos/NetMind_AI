                                            <TextBlock Grid.Column="2" x:Name="AiAttachedFilesSummary" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        </Grid>
                                        <ListBox x:Name="AiAttachedFilesList" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListItem}" Height="66" Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" DisplayMemberPath="Display" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="脚本">
                    <!--
                        脚本页只有一个编辑器。左边选脚本、中间写脚本、右边决定它在采集里怎么用，
                        顶部两个主操作（保存 / 运行）覆盖这一页的全部写入与执行，不再存在第二个隐藏入口。
                    -->
                    <Grid Margin="26,22,26,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="脚本" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="脚本保存在当前工作区 scripts 目录。钩子脚本在采集期间由隔离工作进程执行；验证脚本在受限沙箱里对流量快照跑一次。两者都无法访问网络和任意文件。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" MaxWidth="860" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ScriptGuideButton" Content="脚本指南" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="脚本指南_Click" ToolTip="展开或收起脚本用法速查" />
                                <Button x:Name="InsertSampleButton" Content="插入示例 ▾" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="插入示例_Click" ToolTip="把一份带中文注释的示例脚本写入编辑器，覆盖当前内容" />
                                <Button x:Name="SaveScriptButton" Content="保存" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="保存脚本_Click" ToolTip="把编辑器内容写入脚本文件，并同步保存右侧的采集钩子配置" />
                                <Button x:Name="RunScriptButton" Content="运行" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="运行脚本_Click" ToolTip="按当前脚本的用途执行：钩子脚本做隔离试跑，验证脚本在沙箱中运行一次" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="ScriptGuidePanel" Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource RaisedBrush}" Padding="18,16" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ScriptGuideTitle" Text="脚本指南 · API 速查" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="ScriptGuideText" FontFamily="Cascadia Mono" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Text="完整开发文档：docs\scripting.md" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /><ColumnDefinition Width="352" /></Grid.ColumnDefinitions>

                            <!-- 左：脚本库。目录即真相，列出的就是工作区 scripts 目录下的 *.py -->
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="脚本库" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ScriptLibraryCountText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBox x:Name="ScriptNameBox" Grid.Row="1" Margin="0,10,0,0" MaxLength="61" AutomationProperties.Name="脚本名" ToolTip="新建与重命名使用的脚本名；不必输入 .py 后缀，也不能包含路径分隔符" />
                                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                        <Button x:Name="NewScriptButton" Content="新建 ▾" Style="{StaticResource CompactActionButton}" Padding="10,5" MinHeight="0" FontSize="11.5" Margin="0,0,6,6" Click="新建脚本_Click" ToolTip="按用途新建脚本；脚本名留空时自动取名" />
                                        <Button Content="重命名" Style="{StaticResource CompactActionButton}" Padding="10,5" MinHeight="0" FontSize="11.5" Margin="0,0,6,6" Click="重命名脚本_Click" ToolTip="用上方脚本名重命名当前选中脚本；若它是采集钩子会同步更新配置" />
                                        <Button Content="删除" Style="{StaticResource CompactActionButton}" Padding="10,5" MinHeight="0" FontSize="11.5" Margin="0,0,6,6" Click="删除脚本_Click" ToolTip="删除当前选中的脚本文件" />
                                        <Button Content="刷新" Style="{StaticResource CompactActionButton}" Padding="10,5" MinHeight="0" FontSize="11.5" Margin="0,0,0,6" Click="刷新脚本库_Click" ToolTip="重新读取工作区 scripts 目录与钩子配置" />
                                    </WrapPanel>
                                    <ListBox x:Name="ScriptList" Grid.Row="3" Margin="0,4,0,0" ItemsSource="{Binding Scripts}" SelectionChanged="脚本列表_选择变化" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListItem}" AutomationProperties.Name="脚本库列表">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <Grid>
                                                        <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource GreenBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- 中：唯一的编辑器 -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="7,7,0,0" Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="CurrentScriptNameText" Text="尚未选择脚本" FontFamily="Cascadia Mono" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="300" />
                                                <TextBlock x:Name="ScriptDirtyText" Foreground="{StaticResource AmberBrush}" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="用途" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <ComboBox x:Name="ScriptPurposeCombo" Width="112" SelectionChanged="脚本用途_变化" AutomationProperties.Name="脚本用途" ToolTip="决定「运行」做什么，以及编辑器补全给哪一套词表">
                                                    <ComboBoxItem Content="钩子脚本" />
                                                    <ComboBoxItem Content="验证脚本" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <RichTextBox x:Name="ScriptEditor" Grid.Row="1" Style="{StaticResource PythonCodeEditor}" BorderThickness="0" TextChanged="脚本编辑器_TextChanged" PreviewKeyDown="脚本编辑器_按键" LostKeyboardFocus="脚本编辑器_失焦" AutomationProperties.Name="Python 脚本编辑器"><FlowDocument PagePadding="0" LineHeight="18" LineStackingStrategy="BlockLineHeight"><Paragraph Margin="0" /></FlowDocument></RichTextBox>
                                    <!-- 补全弹层：词表来自 NetMind.Core 的 HookScriptApi，与运行时契约同源，不会和真实字段漂移 -->
                                    <Popup x:Name="ScriptCompletionPopup" Grid.Row="1" Placement="RelativePoint" PlacementTarget="{Binding ElementName=ScriptEditor}" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False">
                                        <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" MaxWidth="520">
                                            <ListBox x:Name="ScriptCompletionList" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListItem}" MaxHeight="220" BorderThickness="0" Background="Transparent" Focusable="False" MouseLeftButtonUp="脚本补全_点击">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2,1">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="12" MinWidth="150" />
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                    <Border Grid.Row="2" Background="{StaticResource RaisedBrush}" CornerRadius="0,0,7,7" Padding="14,7">
                                        <TextBlock x:Name="ScriptEditorHintText" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 右：这个脚本在采集里怎么用 + 运行结果 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="采集钩子（当前工作区）" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="采集期间只执行下面这一个脚本。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,5,0,0" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource RaisedBrush}" CornerRadius="4" Padding="9,7" VerticalAlignment="Center">
                                                <TextBlock x:Name="ActiveHookScriptText" Text="尚未指定" FontFamily="Cascadia Mono" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </Border>
                                            <Button Grid.Column="1" Content="设为采集钩子" Style="{StaticResource CompactActionButton}" Padding="10,6" MinHeight="0" FontSize="11.5" Margin="8,0,0,0" Click="设为采集钩子_Click" ToolTip="把左侧选中的钩子脚本设为采集期间执行的脚本" />
                                        </Grid>
                                        <CheckBox x:Name="HookEnabledBox" Content="启用请求钩子" Margin="0,13,0,0" AutomationProperties.Name="钩子启用开关" Checked="钩子勾选_Changed" Unchecked="钩子勾选_Changed" ToolTip="钩子的唯一启用来源就是这里：勾选后点顶部「保存」写入当前工作区，下次启动采集即拉起钩子工作进程；没有额外的全局总开关" />
                                        <TextBlock Text="挂载点" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,11,0,0" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <CheckBox x:Name="HookBeforeSendBox" Content="发送前" Width="150" Margin="0,0,0,7" AutomationProperties.Name="钩子点：发送前" Checked="钩子勾选_Changed" Unchecked="钩子勾选_Changed" ToolTip="request.before_send · 请求发往上游之前；可拦截改写" />
                                            <CheckBox x:Name="HookAfterSendBox" Content="发送后" Width="150" Margin="0,0,0,7" AutomationProperties.Name="钩子点：发送后" Checked="钩子勾选_Changed" Unchecked="钩子勾选_Changed" ToolTip="request.after_send · 请求已发往上游之后；只观察" />
                                            <CheckBox x:Name="HookBeforeWriteBox" Content="响应写回前" Width="150" Margin="0,0,0,7" AutomationProperties.Name="钩子点：响应写回前" Checked="钩子勾选_Changed" Unchecked="钩子勾选_Changed" ToolTip="response.before_write · 响应写回浏览器之前；可拦截改写" />
                                            <CheckBox x:Name="HookAfterDeliverBox" Content="响应交付后" Width="150" Margin="0,0,0,7" AutomationProperties.Name="钩子点：响应交付后" Checked="钩子勾选_Changed" Unchecked="钩子勾选_Changed" ToolTip="response.after_deliver · 响应已交付浏览器之后；只观察" />
                                        </WrapPanel>
                                        <TextBlock x:Name="HookStatusText" Text="尚未加载钩子配置" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="改动点击顶部「保存」后写入工作区，下次启动采集生效。返回 None 不写审计，返回对象才形成 hooks.finding；数据目录为 scripts/data。" Foreground="{StaticResource AmberBrush}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="运行结果" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ScriptRunStateText" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="SandboxOutput" Text="脚本尚未运行。&#x0a;&#x0a;点击右上角「运行」：钩子脚本会在临时目录里隔离试跑，验证脚本会在受限沙箱中执行一次。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="安全与会话">
                    <Grid Margin="26,22,26,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="285" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18"><TextBlock Text="安全与捕获会话" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="管理当前项目的 HTTPS 解密边界，并查看已经完成的采集会话。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" /></StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="HTTPS 解密与安全边界" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="默认只记录 CONNECT 元数据。明确启用后，工作区 CA 仅加入当前用户证书信任，并解密 HTTP/1.1 请求与响应。证书固定或不希望解密的域名可设为加密直通。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="12" Margin="0,13,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Name="TlsInspectionStatusText" Text="正在检查 HTTPS 解密状态…" Foreground="{StaticResource MutedBrush}" /><WrapPanel Grid.Row="1" Margin="0,9,0,0"><Button x:Name="EnableTlsInspectionButton" Content="启用 HTTPS 正文抓取" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,8,0" Click="启用HTTPS解密_Click" /><Button x:Name="DisableTlsInspectionButton" Content="停用并撤销 CA 信任" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource RedBrush}" Padding="12,7" IsEnabled="False" Click="停用HTTPS解密_Click" /></WrapPanel></Grid></Border>
                                    <TextBlock Text="加密直通域名" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,10,0,3" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="TlsBypassHostsBox" MaxLength="8192" AutomationProperties.Name="HTTPS 加密直通域名" ToolTip="使用逗号分隔，例如：login.example.com, *.bank.example" /><Button Grid.Column="1" Content="保存直通规则" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="保存HTTPS直通规则_Click" /></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="18,0"><TextBlock Text="捕获会话" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="SessionCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" /></Grid>
                                <DataGrid x:Name="SessionGrid" Grid.Row="1" ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="会话_DoubleClick" ToolTip="双击会话可查看其中的流量事务" GridLinesVisibility="All" HorizontalGridLinesBrush="#26FFFFFF" VerticalGridLinesBrush="#26FFFFFF" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="160" ElementStyle="{StaticResource SingleLineCellText}" />
                                        <DataGridTextColumn Header="采集模式" Binding="{Binding Mode}" Width="140" ElementStyle="{StaticResource SingleLineCellText}" />
                                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*" ElementStyle="{StaticResource SingleLineCellText}" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100" ElementStyle="{StaticResource SingleLineCellText}" />
                                        <DataGridTextColumn Header="持续时间" Binding="{Binding Duration}" Width="110" ElementStyle="{StaticResource SingleLineCellText}" />
                                        <DataGridTextColumn Header="事务数" Binding="{Binding TransactionCount}" Width="90" ElementStyle="{StaticResource SingleLineCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="设置">
                    <Grid Margin="26,22,26,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18"><TextBlock Text="偏好与运行参数设置" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="采集行为、隐私边界，以及列表与 AI 证据的条数上限；取数预算与单条正文上限仍由系统统一管理。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" /></StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="采集与监听" FontSize="15" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                                        <StackPanel><TextBlock Text="监听端口" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" /><TextBox x:Name="SettingsListenPortBox" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="监听端口" ToolTip="回环代理监听端口，范围 1024–65535，默认 8877；监听地址固定为本机回环" /><TextBlock Text="范围 1024–65535，默认 8877；监听地址固定为本机回环（127.0.0.1），代理不提供对外监听。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
                                    </Border>
                                    <TextBlock Text="列表与证据条数" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0" />
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="流量列表条数" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" />
                                                    <TextBox x:Name="SettingsTrafficWindowBox" AutomationProperties.Name="流量列表条数" ToolTip="每轮从工作区读取并渲染的最近事务条数，范围 50–2000，默认 200" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="AI 证据条数上限" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" />
                                                    <TextBox x:Name="SettingsAiEvidenceBox" AutomationProperties.Name="AI 证据条数上限" ToolTip="单次分析最多纳入证据池的事务条数，范围 1–1000，默认 200" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="页内 Hook 列表条数" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" />
                                                    <TextBox x:Name="SettingsPageHookWindowBox" AutomationProperties.Name="页内 Hook 列表条数" ToolTip="页内 Hook 列表一次读取的事件条数，范围 50–1000，默认 500" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="会话列表条数" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" />
                                                    <TextBox x:Name="SettingsSessionWindowBox" AutomationProperties.Name="会话列表条数" ToolTip="工作区页展示的最近采集会话条数，范围 10–500，默认 100" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="列表刷新间隔（毫秒）" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,5" />
                                                <TextBox x:Name="SettingsRefreshIntervalBox" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="列表刷新间隔" ToolTip="采集期间流量列表的增量刷新间隔，范围 500–30000 毫秒，默认 1500" />
                                            </StackPanel>
                                            <TextBlock Text="条数越大，单轮读取与界面渲染成本越高；AI 证据条数还会直接影响首轮发送给模型的摘要体积与令牌消耗。修改后立即生效并保存。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SettingsCountsStatusText" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="采集方式" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0" />
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <ComboBox x:Name="SettingsCaptureModeCombo" Width="260" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="采集模式_Changed" AutomationProperties.Name="采集方式">
                                                <ComboBoxItem Content="手动代理（最可控）" Tag="manual_proxy" /><ComboBoxItem Content="自动系统代理（推荐）" Tag="auto_proxy" /><ComboBoxItem Content="WinDivert 静默抓包" Tag="windivert" />
                                            </ComboBox>
                                            <TextBlock x:Name="CaptureModeHelpText" Text="自动系统代理：开始采集时接管 Windows 系统代理，停止或退出时还原；适合浏览器和大多数桌面应用。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,9,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="三种方式互斥，避免同时开启“静默抓包”和“系统代理”造成语义冲突。WinDivert 需要管理员权限和驱动；HTTPS 正文仍由工作区的 HTTPS 解密开关决定。" Foreground="{StaticResource AmberBrush}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <CheckBox x:Name="SettingsSilentCaptureBox" Visibility="Collapsed" />
                                            <CheckBox x:Name="SettingsSystemProxyBox" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <Expander Style="{StaticResource EvidenceSectionExpander}" IsExpanded="False" Margin="0,20,0,0">
                                        <Expander.Header><TextBlock Text="采集浏览器测试画像（可选）" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                                            <StackPanel>
                                                <CheckBox x:Name="SettingsBrowserProfileEnabledBox" Content="启用一致的浏览器环境画像" ToolTip="仅作用于 NetMind 打开的采集浏览器；新标签页会通过 CDP 自动应用同一画像" />
                                                <TextBlock x:Name="BrowserProfileSummaryText" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="User-Agent" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                    <TextBox x:Name="SettingsBrowserUserAgentBox" Grid.Column="1" Grid.ColumnSpan="3" ToolTip="留空表示使用浏览器真实 UA；填写后会同步覆盖 Client Hints" />
                                                    <TextBlock Grid.Row="1" Text="平台" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,9,0,0" />
                                                    <ComboBox x:Name="SettingsBrowserPlatformCombo" Grid.Row="1" Grid.Column="1" Margin="0,9,12,0">
                                                        <ComboBoxItem Content="Windows (Win32)" Tag="Win32" /><ComboBoxItem Content="Linux x64" Tag="Linux x86_64" /><ComboBoxItem Content="macOS Intel" Tag="MacIntel" />
                                                    </ComboBox>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="分辨率 / DPR" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,9,0,0" />
                                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,9,0,0">
                                                        <TextBox x:Name="SettingsBrowserWidthBox" Width="82" /><TextBlock Text=" × " VerticalAlignment="Center" /><TextBox x:Name="SettingsBrowserHeightBox" Width="82" /><TextBlock Text=" @ " VerticalAlignment="Center" Margin="8,0,0,0" /><TextBox x:Name="SettingsBrowserDprBox" Width="62" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="2" Text="CPU 核心数" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,9,0,0" />
                                                    <TextBox x:Name="SettingsBrowserCpuBox" Grid.Row="2" Grid.Column="1" Margin="0,9,12,0" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="时区" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,9,0,0" />
                                                    <TextBox x:Name="SettingsBrowserTimezoneBox" Grid.Row="2" Grid.Column="3" Margin="0,9,0,0" />
                                                    <TextBlock Grid.Row="3" Text="区域" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,9,0,0" />
                                                    <TextBox x:Name="SettingsBrowserLocaleBox" Grid.Row="3" Grid.Column="1" Margin="0,9,12,0" />
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="语言" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,9,0,0" />
                                                    <TextBox x:Name="SettingsBrowserLanguageBox" Grid.Row="3" Grid.Column="3" Margin="0,9,0,0" />
                                                    <TextBlock Grid.Row="4" Text="WebRTC" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,9,0,0" />
                                                    <ComboBox x:Name="SettingsBrowserWebRtcCombo" Grid.Row="4" Grid.Column="1" Margin="0,9,12,0">
                                                        <ComboBoxItem Content="阻止非代理 UDP（推荐）" Tag="disable_non_proxied_udp" /><ComboBoxItem Content="仅默认公网接口" Tag="default_public_interface_only" /><ComboBoxItem Content="浏览器默认" Tag="default" />
                                                    </ComboBox>
                                                    <Button Grid.Row="4" Grid.Column="3" Content="生成一致画像" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,6" Margin="0,9,0,0" Click="生成浏览器画像_Click" />
                                                </Grid>
                                                <TextBlock Text="仅覆盖 Chromium/CDP 能稳定控制的字段。WebGL、Canvas、字体和内存不做伪造，避免参数表面一致但底层渲染仍暴露真实环境。修改后需重新打开采集浏览器。" Foreground="{StaticResource AmberBrush}" FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                    <TextBlock Text="请求钩子（脚本挂接关键路径）" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0" />
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="请求钩子按工作区启用，没有全局开关：当前工作区 scripts/hook-config.json 是唯一的启用来源，采集后台只认它。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="9,7" VerticalAlignment="Center">
                                                    <TextBlock x:Name="SettingsHookSummaryText" Text="尚未加载钩子配置" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </Border>
                                                <Button Grid.Column="1" Content="去脚本页配置" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0" Click="前往脚本页配置钩子_Click" ToolTip="在脚本页指定采集钩子脚本、勾选挂载点并启用，点顶部「保存」写入当前工作区" />
                                            </Grid>
                                            <TextBlock Text="在脚本页用「设为采集钩子」指定脚本、勾选挂载点、勾选「启用请求钩子」，再点顶部「保存」即可挂载；采集期间钩子会在请求发送前、发送后、响应写回前、响应交付后四个关键路径点观察流量。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="注意：钩子脚本故障不影响流量捕获（无感直通）；加密隧道（未解密的 HTTPS）内容不可钩；配置变更在下次启动采集时生效。" Foreground="{StaticResource AmberBrush}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="15,8" Click="保存设置_Click" />
                                        <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="安全说明：监听地址固定为本机回环；采集进行中无法修改监听端口。刷新频率、列表容量和 AI 取数预算由系统统一管理。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
