<Application x:Class="NetMind.Workbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#090F16" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0C141E" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111C28" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#172534" />
        <SolidColorBrush x:Key="BorderBrush" Color="#24384A" />
        <!-- 低刺激深色主题：保留类型语义，但避免正文近纯白、状态色接近霓虹色造成长时间阅读疲劳。 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#79B8B3" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#18343A" />
        <SolidColorBrush x:Key="TextBrush" Color="#CED9DF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8798A4" />
        <SolidColorBrush x:Key="BlueBrush" Color="#7EA9C4" />
        <SolidColorBrush x:Key="GreenBrush" Color="#82B89B" />
        <SolidColorBrush x:Key="AmberBrush" Color="#C7AA72" />
        <SolidColorBrush x:Key="RedBrush" Color="#D8868F" />
        <SolidColorBrush x:Key="ResourceImageBrush" Color="#82B8B4" />
        <SolidColorBrush x:Key="ResourceApiBrush" Color="#88B99D" />
        <SolidColorBrush x:Key="ResourceScriptBrush" Color="#C4AD78" />
        <SolidColorBrush x:Key="ResourceStyleBrush" Color="#86AAC3" />
        <SolidColorBrush x:Key="ResourceFontBrush" Color="#A99AC4" />
        <SolidColorBrush x:Key="ResourceMediaBrush" Color="#C58D94" />
        <SolidColorBrush x:Key="ResourceDocumentBrush" Color="#AEBCC4" />
        <SolidColorBrush x:Key="ResourceConnectBrush" Color="#95A7B2" />
        <SolidColorBrush x:Key="ResourceOtherBrush" Color="#8798A4" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 深色列表（内容搜索结果 / AI 附加文件 / 缓存资源选取），与暗色主题一致；全局共享供代码构建窗口查找 -->
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="项背景" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="项背景" Property="Background" Value="{StaticResource RaisedBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="项背景" Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#051516" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="边框" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="边框" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="边框" Property="Opacity" Value="0.70" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="边框" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        </Style>
        <!-- 面板内的紧凑操作按钮：显式边框与独立底色，避免在 RaisedBrush 容器中退化成“可点击文字”。 -->
        <Style x:Key="CompactActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#466178" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="操作边框" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="操作边框" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter TargetName="操作边框" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="操作边框" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="操作边框" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource CompactActionButton}">
            <Setter Property="Foreground" Value="#051516" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource CompactActionButton}">
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
            <Setter Property="Background" Value="#2A1821" />
            <Setter Property="BorderBrush" Value="#84434F" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="导航背景" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="导航背景" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="选中">
                                <Setter TargetName="导航背景" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="勾选框" Width="17" Height="17" CornerRadius="4" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="勾号" Text="✓" Visibility="Collapsed" Foreground="#061719" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="勾选框" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="勾选框" Property="Background" Value="{StaticResource AccentBrush}" /><Setter TargetName="勾选框" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="勾号" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="菜单背景" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="菜单背景" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EvidenceTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="标签边框" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter TargetName="标签边框" Property="Background" Value="{StaticResource RaisedBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="标签边框" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="标签边框" Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EvidenceTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource EvidenceTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0" KeyboardNavigation.TabIndex="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EvidenceSectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="区块背景" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton x:Name="区块开关" DockPanel.Dock="Top" Focusable="False" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="标题背景" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="箭头" Text="▾" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                                                    <ContentPresenter Grid.Column="1" ContentSource="Content" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="标题背景" Property="Background" Value="{StaticResource SurfaceBrush}" /><Setter TargetName="箭头" Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                                                <Trigger Property="IsChecked" Value="False"><Setter TargetName="箭头" Property="Text" Value="▸" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="区块内容" Visibility="Collapsed" Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="区块内容" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- JSON 树视图深色资源：树节点行模板 + 深色 TreeViewItem 模板 + TreeView 样式 -->
        <HierarchicalDataTemplate x:Key="JsonTreeNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="键名文本" Text="{Binding Key, StringFormat='&quot;{0}&quot;: '}" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="容器括号文本" Text="" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="容器摘要文本" Text="{Binding DisplayText}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0" />
                <TextBlock x:Name="值文本" Text="{Binding DisplayText}" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <!-- 数组元素与根节点没有键名 -->
                <DataTrigger Binding="{Binding Key}" Value="{x:Null}">
                    <Setter TargetName="键名文本" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- 容器节点：显示 {…} / […] 摘要，隐藏值文本 -->
                <DataTrigger Binding="{Binding IsContainer}" Value="True">
                    <Setter TargetName="容器括号文本" Property="Visibility" Value="Visible" />
                    <Setter TargetName="值文本" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Object">
                    <Setter TargetName="容器括号文本" Property="Text" Value="{}{…}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Array">
                    <Setter TargetName="容器括号文本" Property="Text" Value="{}[…]" />
                </DataTrigger>
                <!-- 叶子节点：按值类型着色，隐藏容器摘要 -->
                <DataTrigger Binding="{Binding IsContainer}" Value="False">
                    <Setter TargetName="容器摘要文本" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="String">
                    <Setter TargetName="值文本" Property="Foreground" Value="{StaticResource GreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Number">
                    <Setter TargetName="值文本" Property="Foreground" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                    <Setter TargetName="值文本" Property="Foreground" Value="{StaticResource BlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Null">
                    <Setter TargetName="值文本" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
                <!-- “其余 N 项已省略”提示节点：弱化斜体 -->
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter TargetName="值文本" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="值文本" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <Style x:Key="JsonTreeView" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemTemplate" Value="{StaticResource JsonTreeNodeTemplate}" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JsonTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="展开开关" Focusable="False" Width="16" ClickMode="Press" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Width="16" Height="16">
                                            <TextBlock x:Name="展开箭头" Text="▾" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False"><Setter TargetName="展开箭头" Property="Text" Value="▸" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="展开箭头" Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="行背景" Grid.Column="1" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="节点头部" ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="子项列表" Grid.Row="1" Grid.Column="1" Margin="15,0,0,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="子项列表" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="展开开关" Property="Visibility" Value="Hidden" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="行背景" Property="Background" Value="{StaticResource SurfaceBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="行背景" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeView" BasedOn="{StaticResource JsonTreeView}" />
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource JsonTreeViewItem}" />
        <Style x:Key="EvidenceTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.45" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="复制所选内容" Command="{x:Static ApplicationCommands.Copy}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="全选" Command="{x:Static ApplicationCommands.SelectAll}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 只读富文本证据区：支持键值分色渲染与关键字选中高亮，样式与 EvidenceTextBox 对齐 -->
        <Style x:Key="EvidenceRichBox" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.45" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="复制所选内容" Command="{x:Static ApplicationCommands.Copy}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="全选" Command="{x:Static ApplicationCommands.SelectAll}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PythonCodeEditor" TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.38" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="SpellCheck.IsEnabled" Value="False" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="撤销" Command="{x:Static ApplicationCommands.Undo}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="重做" Command="{x:Static ApplicationCommands.Redo}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="剪切" Command="{x:Static ApplicationCommands.Cut}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="复制" Command="{x:Static ApplicationCommands.Copy}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="粘贴" Command="{x:Static ApplicationCommands.Paste}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="全选" Command="{x:Static ApplicationCommands.SelectAll}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="下拉按钮" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{x:Null}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                          Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="按钮背景" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="按钮背景" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="按钮背景" Property="Background" Value="{StaticResource SidebarBrush}" /><Setter TargetName="按钮背景" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- 显示区与下拉按钮分离：点击文字区不触发下拉，箭头与背景负责开合 -->
                            <Grid Margin="10,0,28,0" VerticalAlignment="Center">
                                <ContentPresenter x:Name="选中文本" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}" FontSize="15" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,3,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="选项背景" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="选项背景" Property="Background" Value="{StaticResource RaisedBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="选项背景" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Background" Value="#0E1A25" />
            <Setter Property="Foreground" Value="#426979" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="2">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton><RepeatButton x:Name="减少区域" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="滑块" Background="{TemplateBinding Foreground}" MinWidth="8" MinHeight="44">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="滑块背景" Background="{TemplateBinding Background}" CornerRadius="4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="滑块背景" Property="Background" Value="#5F93A5" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="滑块背景" Property="Background" Value="{StaticResource AccentBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton x:Name="增加区域" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="减少区域" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="增加区域" Property="Command" Value="ScrollBar.PageRightCommand" />
                                <Setter TargetName="滑块" Property="MinWidth" Value="44" />
                                <Setter TargetName="滑块" Property="MinHeight" Value="8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="MinHeight" Value="14" />
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="MinHeight" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#13202C" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
            <!-- 表头内容也受应用级 TextBlock 隐式换行样式影响，窄列会把“主机/域名”等标题折行，必须显式单行；
                 用 ContentPresenter + 局部隐式 TextBlock 样式而非 TextBlock Text={Binding}，否则勾选框列的 CheckBox 表头会被字符串化成控件类型名 -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </Grid.Resources>
                            <ContentPresenter Content="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 表格单元格文本统一单行：应用级 TextBlock 隐式样式是换行，列宽不足时长端点会折行，必须逐列显式覆盖；
             默认 DataGridCell 模板不应用 Padding，左侧内边距改由文本自身承担，避免内容贴住卡片边框 -->
        <Style x:Key="SingleLineCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="TrafficResourceRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResourceKind}" Value="图片"><Setter Property="Foreground" Value="{StaticResource ResourceImageBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="接口数据"><Setter Property="Foreground" Value="{StaticResource ResourceApiBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="脚本"><Setter Property="Foreground" Value="{StaticResource ResourceScriptBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="样式"><Setter Property="Foreground" Value="{StaticResource ResourceStyleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="字体"><Setter Property="Foreground" Value="{StaticResource ResourceFontBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="媒体"><Setter Property="Foreground" Value="{StaticResource ResourceMediaBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="文档"><Setter Property="Foreground" Value="{StaticResource ResourceDocumentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="连接"><Setter Property="Foreground" Value="{StaticResource ResourceConnectBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="其他"><Setter Property="Foreground" Value="{StaticResource ResourceOtherBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 类型徽章：色块背景 + 深色粗体短文本，比符号图形醒目；背景色按资源类型切换，与整行着色同源 -->
        <DataTemplate x:Key="TrafficResourceIconTemplate">
            <Border x:Name="徽章背景" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource ResourceOtherBrush}" ToolTip="{Binding ResourceType}">
                <TextBlock x:Name="徽章文本" Text="{Binding ResourceIcon}" FontFamily="Cascadia Mono" FontWeight="Bold" FontSize="10" Foreground="#0A1218" TextAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ResourceKind}" Value="图片"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceImageBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="接口数据"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceApiBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="脚本"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceScriptBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="样式"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceStyleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="字体"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceFontBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="媒体"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceMediaBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="文档"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceDocumentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ResourceKind}" Value="连接"><Setter TargetName="徽章背景" Property="Background" Value="{StaticResource ResourceConnectBrush}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Application.Resources>
</Application>
